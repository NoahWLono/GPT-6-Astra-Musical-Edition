structure AlgebraicTunings.GoldenAP (phi : ℝ) (B : ℤ) (n : ℕ) : Type
number of parameters: 3
fields:
  AlgebraicTunings.GoldenAP.a : ℤ
  AlgebraicTunings.GoldenAP.b : ℤ
