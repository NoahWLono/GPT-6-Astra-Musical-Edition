def AlgebraicTunings.goldenNorm : ℤ → ℤ → ℤ :=
fun a b => b * b + a * b - a * a
def AlgebraicTunings.goldenPhi : ℝ :=
(1 + √5) / 2
def AlgebraicTunings.goldenThresholdIndex : ℕ → ℤ :=
fun B => ↑((4 * B + 3) / 5).sqrt
def AlgebraicTunings.goldenMaximumLength : ℕ → ℤ :=
fun B => goldenLineCount goldenPhi (goldenThresholdIndex B) √(5 * ↑(goldenThresholdIndex B) ^ 2 + 4 * ↑B)
golden_exact_maximum : ∀ (B : ℕ),
  64 ≤ B →
    (∃ n P, ↑n + 1 = goldenMaximumLength B) ∧
      (∀ (n : ℕ) (P : GoldenAP goldenPhi (↑B) n), ↑n + 1 ≤ goldenMaximumLength B) ∧
        ∀ (n : ℕ) (P : GoldenAP goldenPhi (↑B) n), ↑n + 1 = goldenMaximumLength B → |goldenNorm P.c P.d| = 1
goldenMaximumLength_formula : ∀ (B : ℕ),
  goldenMaximumLength B =
    ⌊(-↑(goldenThresholdIndex B) + √(5 * ↑(goldenThresholdIndex B) ^ 2 + 4 * ↑B)) / 2⌋ +
      ⌈↑(goldenThresholdIndex B) * goldenPhi⌉
exact_statement : ∀ (B : ℕ),
  64 ≤ B →
    have phi := (1 + √5) / 2;
    have M := ↑((4 * B + 3) / 5).sqrt;
    have F := ⌊(-↑M + √(5 * ↑M ^ 2 + 4 * ↑B)) / 2⌋ + ⌈↑M * phi⌉;
    (∃ n P, ↑n + 1 = F) ∧
      (∀ (n : ℕ) (P : GoldenAP phi (↑B) n), ↑n + 1 ≤ F) ∧
        ∀ (n : ℕ) (P : GoldenAP phi (↑B) n), ↑n + 1 = F → |goldenNorm P.c P.d| = 1
