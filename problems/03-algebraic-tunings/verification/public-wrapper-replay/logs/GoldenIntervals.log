quadratic_one_sided_span_sq : ∀ (C a b D : ℝ),
  a ≤ b → |a * (a - D)| ≤ C → |b * (b - D)| ≤ C → b ≤ D / 2 ∨ D / 2 ≤ a → (b - a) ^ 2 ≤ 2 * C
positive_quadratic_interval_bound : ∀ (C a b D r s : ℝ),
  0 < a →
    a ≤ b → 0 ≤ r → r ^ 2 = C → 0 ≤ s → s ^ 2 = 2 → (∀ (x : ℝ), a ≤ x → x ≤ b → |x * (x - D)| ≤ C) → b - a ≤ (1 + s) * r
monic_quadratic_cell_bound : ∀ (p q u s K : ℝ),
  0 ≤ s →
    s ≤ 1 → |u ^ 2 + p * u + q| ≤ K → |(u + 1) ^ 2 + p * (u + 1) + q| ≤ K → |(u + s) ^ 2 + p * (u + s) + q| ≤ K + 1 / 4
monic_quadratic_discrete_to_continuous : ∀ (p q K : ℝ) (n : ℕ),
  0 ≤ K → (∀ j ≤ n, |↑j ^ 2 + p * ↑j + q| ≤ K) → ∀ (t : ℝ), 0 ≤ t → t ≤ ↑n → |t ^ 2 + p * t + q| ≤ K + 1 / 4
monic_discrete_positive_span_bound : ∀ (alpha beta K r s : ℝ) (n : ℕ),
  0 < alpha →
    0 ≤ K →
      0 ≤ r → r ^ 2 = K + 1 / 4 → 0 ≤ s → s ^ 2 = 2 → (∀ j ≤ n, |(↑j + alpha) * (↑j + beta)| ≤ K) → ↑n ≤ (1 + s) * r
'AlgebraicTunings.quadratic_one_sided_span_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
