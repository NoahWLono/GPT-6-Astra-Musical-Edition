goldenNorm_lower_bound_of_discrete_depth : ∀ (m b B : ℤ), 5 * m * m / 4 ≤ B → -B ≤ goldenNorm m b
goldenNorm_at_integer_vertex : ∀ (m : ℤ), goldenNorm m (-(m / 2)) = -(5 * m * m / 4)
'AlgebraicTunings.goldenNorm_lower_bound_of_discrete_depth' depends on axioms: [propext, Classical.choice, Quot.sound]
'AlgebraicTunings.goldenNorm_at_integer_vertex' depends on axioms: [propext, Quot.sound]
'AlgebraicTunings.goldenNorm_forbidden_vertex' depends on axioms: [propext, Quot.sound]
