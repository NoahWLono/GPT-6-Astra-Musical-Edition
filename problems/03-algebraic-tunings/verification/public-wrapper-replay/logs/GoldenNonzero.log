goldenNorm_eq_zero_iff : ∀ (a b : ℤ), goldenNorm a b = 0 ↔ a = 0 ∧ b = 0
goldenNorm_abs_pos : ∀ (a b : ℤ), a ≠ 0 ∨ b ≠ 0 → 0 < |goldenNorm a b|
'AlgebraicTunings.goldenNorm_eq_zero_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
'AlgebraicTunings.goldenNorm_abs_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
