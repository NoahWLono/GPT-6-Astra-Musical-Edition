golden_unit_run_count_upper : ∀ (phi : ℝ) (m b B : ℤ) (n : ℕ) (r : ℝ),
  0 ≤ r →
    r ^ 2 = 5 * ↑m ^ 2 + 4 * ↑B → 0 < goldenEval phi m b → goldenNorm m (b + ↑n) ≤ B → ↑n + 1 ≤ goldenLineCount phi m r
