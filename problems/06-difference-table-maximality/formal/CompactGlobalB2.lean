noncomputable def cert (g : Choices) : ReverseCertificate :=
  if (∀ e, candidate g e = map0 e) then cert0 else
  if (∀ e, candidate g e = map1 e) then cert1 else
  if (∀ e, candidate g e = map2 e) then cert2 else
  if (∀ e, candidate g e = map3 e) then cert3 else
  if (∀ e, candidate g e = map4 e) then cert4 else
  if (∀ e, candidate g e = map5 e) then cert5 else
  if (∀ e, candidate g e = map6 e) then cert6 else
  cert7
theorem valid : ∀ g : Choices, (cert g).Valid 1 1 pi (candidate g) := by decide +kernel
theorem globally_maximal : ∀ σ : Fin 10 ≃ Fin 10,
    (∀ z, TableHolds 1 1 pi z → TableHolds 1 1 σ z) →
    ∀ z, TableHolds 1 1 σ z → TableHolds 1 1 pi z := by
  apply table_maximality_from_fibers 1 1 pi block
  · apply samples_bound_collisions 1 1 pi samples block
    · decide +kernel
    · decide +kernel
  · intro g; exact compact_reverse_sound 1 1 pi (candidate g) (cert g) (valid g)
#print axioms globally_maximal
end DifferenceTableResearch.CompactMaximalB2
